# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to GitHub.

# App
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Resume upload limits (optional; these are the defaults)
MAX_UPLOAD_SIZE_MB=5
MAX_PDF_PAGES=15
MAX_RESUME_CHARS=50000
MIN_RESUME_CHARS=50

# Groq AI (Milestone 7)
GROQ_API_KEY=your_groq_api_key_here
LLM_ENABLED=true
GROQ_MODEL=openai/gpt-oss-120b
# "low", "medium" or "high" for gpt-oss models. Leave empty for other models.
GROQ_REASONING_EFFORT=low
# true = strict schema mode (only on models that support it)
GROQ_STRICT_SCHEMA=false

# MongoDB (needed from Milestone 9)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hireiq

# Optional web research (Milestone 13)
EXA_API_KEY=your_exa_api_key_here